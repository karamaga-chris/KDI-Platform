# Copy to .env and adjust.
# connection_limit caps Prisma's pool. On a 1-2 vCPU host, Postgres' own
# max_connections is typically ~100; a single-instance Node API doesn't need
# more than a handful of connections — 5 leaves headroom for other clients
# (migrations, psql, a second app instance) and avoids exhausting Postgres
# under concurrent load. Raise it only if profiling shows queueing.
DATABASE_URL="postgresql://kdi:kdi@localhost:5433/kdi?schema=public&connection_limit=5"
PORT=4000
NODE_ENV=development

# ---- CORS ----
# Comma-separated allowlist of origins allowed to call this API. Required in
# production (server refuses to start without it). Defaults to the Vite dev
# server origin (http://localhost:5173) if unset in development.
ALLOWED_ORIGIN=http://localhost:5173

# ---- Operator console auth ----
# Shared bearer token required on all /api/* routes except /api/health.
# Required in production; if unset in development, auth is skipped (with a
# startup warning) so local demos work without extra setup.
API_TOKEN=

# ---- Monitoring adapter selection (most real option wins) ----
# 1) Real + persistent: set an UptimeRobot free-tier API key.
#    Create one free at https://uptimerobot.com (My Settings -> API -> Main API Key).
UPTIMEROBOT_API_KEY=
# 2) Real timed HTTP probe (no account needed). Ignored if UPTIMEROBOT_API_KEY is set.
MONITOR_REAL_HTTP=1
# 3) If neither is configured, the app uses the simulated LatencyProber (demo mode).

# ---- Local "Tier III" mock origin (fixes the latency demo) ----
# <100ms is a Kigali-user -> Kigali-local-server target. Probing a public site
# (e.g. Wikipedia) can never validate that number — you'd be measuring internet
# transit distance, not the thing the product improves. Run `npm run dev:origin`
# in a separate terminal (see mock-origin.ts) and point monitoring at it instead.
MOCK_ORIGIN_URL=http://localhost:5050/ping
MOCK_ORIGIN_PORT=5050

# Illustrative FX for RWF-denominated invoices.
USD_TO_RWF=1300
