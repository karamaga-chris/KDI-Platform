# Copy to .env and adjust.
DATABASE_URL="postgresql://kdi:kdi@localhost:5433/kdi?schema=public"
PORT=4000

# ---- Monitoring adapter selection (most real option wins) ----
# 1) Real + persistent: set an UptimeRobot free-tier API key.
#    Create one free at https://uptimerobot.com (My Settings -> API -> Main API Key).
UPTIMEROBOT_API_KEY=
# 2) Real timed HTTP probe (no account needed). Ignored if UPTIMEROBOT_API_KEY is set.
MONITOR_REAL_HTTP=1
# 3) If neither is configured, the app uses the simulated LatencyProber (demo mode).

# ---- Local "Tier III" mock origin (fixes the latency demo) ----
# <100ms is a Kigali-user -> Kigali-local-server target. Probing a public site
# (e.g. Wikipedia) can never validate that number — you'd be measuring internet
# transit distance, not the thing the product improves. Run `npm run dev:origin`
# in a separate terminal (see mock-origin.ts) and point monitoring at it instead.
MOCK_ORIGIN_URL=http://localhost:5050/ping
MOCK_ORIGIN_PORT=5050

# Illustrative FX for RWF-denominated invoices.
USD_TO_RWF=1300
