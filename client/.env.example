# Copy to .env.local and adjust.

# Base URL of the KDI API.
VITE_API=http://localhost:4000

# Must match the server's API_TOKEN (server/.env) once the server has one
# configured. Leave unset while the server is running in unauthenticated dev mode.
VITE_API_TOKEN=

# Live-monitoring poll interval in milliseconds (default 3000 if unset).
VITE_POLL_MS=3000
